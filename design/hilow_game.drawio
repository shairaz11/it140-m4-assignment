// Higher/Lower Game Pseudocode

Declare Integer lowerBound
Declare Integer upperBound
Declare Integer randomNumber
Declare Integer guess

Output "Welcome to the Higher/Lower Game!"

// Get valid lower and upper bounds
Output "Enter the lower bound:"
Input lowerBound

Output "Enter the upper bound:"
Input upperBound

While lowerBound >= upperBound
    Output "Error: Lower bound must be less than upper bound."

    Output "Enter the lower bound:"
    Input lowerBound

    Output "Enter the upper bound:"
    Input upperBound
End While

// Generate random number
randomNumber = Random Number Between lowerBound and upperBound

// Get user's first guess
Output "Enter a guess between ", lowerBound, " and ", upperBound, ":"
Input guess

// Validate guess
While guess < lowerBound OR guess > upperBound
    Output "Invalid guess. Please enter a number within the range."
    Input guess
End While

// Continue game until correct guess
While guess <> randomNumber

    If guess < randomNumber Then
        Output "Too low! Try again."
    Else
        Output "Too high! Try again."
    End If

    Output "Enter a guess between ", lowerBound, " and ", upperBound, ":"
    Input guess

    While guess < lowerBound OR guess > upperBound
        Output "Invalid guess. Please enter a number within the range."
        Input guess
    End While

End While

Output "Correct! You guessed the number!"
