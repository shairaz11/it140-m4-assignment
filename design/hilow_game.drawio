START

Display "Welcome to the Higher/Lower Game!"

// Get lower and upper bounds
INPUT lowerBound: 1
INPUT upperBound: 10

// Validate bounds
WHILE lowerBound >= upperBound
    Display "Invalid range. Lower bound must be less than upper bound."
    INPUT lowerBound
    INPUT upperBound
END WHILE

// Generate random number
SET randomNumber = Random number between lowerBound and upperBound

// Get first guess
INPUT guess

// Validate guess
WHILE guess < lowerBound OR guess > upperBound
    Display "Invalid guess. Enter a number between lowerBound and upperBound."
    INPUT guess
END WHILE

// Game loop
WHILE guess != randomNumber

    IF guess < randomNumber THEN
        Display "Too low! Try again."
    ELSE
        Display "Too high! Try again."
    END IF

    INPUT guess

    // Validate new guess
    WHILE guess < lowerBound OR guess > upperBound
        Display "Invalid guess. Enter a number between lowerBound and upperBound."
        INPUT guess
    END WHILE

END WHILE

Display "Congratulations! You guessed the correct number!"

END
